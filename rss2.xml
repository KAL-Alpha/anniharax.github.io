      <author>anniharax</author>
      <category domain="https://www.anniharax.com/categories/%E9%A1%B9%E7%9B%AE%E5%88%86%E4%BA%AB/">项目分享</category>
      <category domain="https://www.anniharax.com/tags/%E8%B5%A4%E7%9F%B3%E7%A7%91%E6%8A%80/">赤石科技</category>
